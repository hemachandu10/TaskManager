# ====================================================================
# TaskVault Environment Variables Template
# Copy this file to .env.local for local development.
# Add these variables in Vercel Project Settings > Environment Variables.
# ====================================================================

# 1. Supabase Project URL (Required, Public)
# Found in: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co


# 2. Supabase Anonymous / Publishable Key (Required, Public)
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > "anon" "public"
# This key is safe to expose to browser clients because Row-Level Security (RLS) protects user data.
# NEVER expose the 'service_role' secret key here or in client-facing code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# 3. Application Base URL (Optional)
# Used for OAuth redirects and canonical site metadata.
# Local development: http://localhost:3000
# Production: https://your-taskvault-deployment.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
